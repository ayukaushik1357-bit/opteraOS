# ─────────────────────────────────────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID="your_project_id"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_URL="https://your_project.supabase.co"

# Server-only — NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Client-side Supabase config (VITE_ prefix = bundled into browser JS)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider Keys — Server-Side Only — NEVER expose to browser
# Priority cascade: GEMINI_API_KEY → OPENAI_API_KEY → Structured Configuration Notice
# ─────────────────────────────────────────────────────────────────────────────
# Required for:
#   • RAG document embedding (text-embedding-004)
#   • Semantic vector search (match_document_chunks RPC)
#   • AI chat responses (gemini-1.5-flash / gemini-2.0-flash)
# Without this key: embeddings are NOT generated, semantic RAG is UNAVAILABLE,
# and AI chat returns AI_PROVIDER_NOT_CONFIGURED.
GEMINI_API_KEY="your_gemini_api_key"

# Required for AI chat when GEMINI_API_KEY is absent.
OPENAI_API_KEY="your_openai_api_key"

# ─────────────────────────────────────────────────────────────────────────────
# Email Delivery Providers (Transactional & Autopilot Follow-ups)
# ─────────────────────────────────────────────────────────────────────────────
# Option 1: Resend (Recommended)
RESEND_API_KEY="re_your_resend_api_key"

# Option 2: SendGrid
SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# Option 3: Standard SMTP
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="notifications@yourdomain.com"

# ─────────────────────────────────────────────────────────────────────────────
# Automation / n8n Integration
# ─────────────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL="https://your-n8n-instance.com/webhook"

# ─────────────────────────────────────────────────────────────────────────────
# OAuth Providers (Server-Side Only)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
