# ─────────────────────────────────────────────────────────────────────────────
# opteraOS Frontend — Environment Configuration
# This is a TanStack Start app: it has both browser code and server-rendered
# code (server functions, Nitro API routes) in this ONE deployable. Variables
# WITHOUT the VITE_ prefix are server-only and never reach the browser bundle;
# VITE_-prefixed variables ARE bundled into client-side JS, so never put a
# secret there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (this app's database & auth — see ../database) ──────────────────
SUPABASE_PROJECT_ID="your_project_id"
SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_URL="https://your_project.supabase.co"

# Server-only — NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Client-side Supabase config (bundled into browser JS)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# ── AI Provider Keys (server-only) ────────────────────────────────────────────
# Priority cascade: GEMINI_API_KEY → OPENAI_API_KEY → deterministic fallback
# Used for: RAG embeddings, semantic search, AI chat, and the Autopilot AI
# planning/execution engine.
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"

# ── Email Delivery (server-only, for transactional & autopilot follow-ups) ──
RESEND_API_KEY="re_your_resend_api_key"
# — or —
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
# — or —
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="notifications@yourdomain.com"

# ── Razorpay Payments (server-only — used by /server/routes/api/razorpay-webhook.ts) ──
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ── Automation / n8n Integration (server-only) ────────────────────────────────
N8N_WEBHOOK_BASE_URL="https://your-n8n-instance.com/webhook"

# ── Google OAuth (server-only, used by Supabase Auth's Google provider) ──────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── Backend API (only needed if you deploy ../backend separately and still ──
# use any of its endpoints from the frontend — most of the app talks to
# Supabase directly and does NOT need this) ──────────────────────────────────
VITE_API_URL="https://your-backend-domain.com/api"
