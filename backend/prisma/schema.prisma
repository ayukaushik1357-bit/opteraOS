// ============================================================================
// opteraOS — Prisma Database Schema
// PostgreSQL + Multi-tenant SaaS
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CustomerStatus {
  ACTIVE
  PROSPECT
  INACTIVE
  CHURNED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  STAGE_CHANGE
  STATUS_CHANGE
  MESSAGE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  NEW_LEAD
  DEAL_UPDATE
  INVOICE_OVERDUE
  AUTOMATION_FAILURE
  AI_ACTION_REQUIRED
  SYSTEM_ALERT
  PAYMENT_RECEIVED
}


enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  BILLED
  CANCELLED
}

enum ManufacturingStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

// ============================================================================
// CORE: Users & Organizations (Multi-Tenant Foundation)
// ============================================================================

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  firstName      String
  lastName       String
  avatarUrl      String?
  phone          String?
  isEmailVerified Boolean  @default(false)
  emailVerifyToken String? @unique
  passwordResetToken String? @unique
  passwordResetExpiry DateTime?
  refreshTokenHash  String?
  googleId       String?  @unique
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  memberships    OrganizationMember[]
  sentInvites    Invitation[]         @relation("InviteSender")
  notifications  Notification[]
  tasks          Task[]               @relation("AssignedTasks")
  createdTasks   Task[]               @relation("CreatedTasks")
  activities     Activity[]
  aiConversations AIConversation[]
  auditLogs      AuditLog[]
  createdLeads   Lead[]               @relation("LeadCreator")
  ownedLeads     Lead[]               @relation("LeadOwner")
  createdDeals   Deal[]               @relation("DealCreator")
  ownedDeals     Deal[]               @relation("DealOwner")
  usageLedgers   UsageLedger[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  website     String?
  industry    String?
  businessType String?
  currency    String   @default("INR")
  timezone    String   @default("Asia/Kolkata")
  country     String   @default("IN")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members       OrganizationMember[]
  invitations   Invitation[]
  customers     Customer[]
  leads         Lead[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  products      Product[]
  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]
  workflows     Workflow[]
  aiConversations AIConversation[]
  notifications  Notification[]
  campaigns     Campaign[]
  integrations  Integration[]
  auditLogs     AuditLog[]
  departments   Department[]
  teams         Team[]
  usageLedgers  UsageLedger[]
  contacts      Contact[]
  companies     Company[]
  quotations    Quotation[]
  accounts      Account[]
  journalEntries JournalEntry[]
  expenses      Expense[]
  vendors       Vendor[]
  purchaseOrders PurchaseOrder[]
  bills         VendorBill[]
  boms          BillOfMaterials[]
  manufacturingOrders ManufacturingOrder[]
  tickets       Ticket[]
  pricelists    PriceList[]
  projects      Project[]
  employees     Employee[]
  channels      Channel[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole     @default(EMPLOYEE)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           UserRole     @default(EMPLOYEE)
  status         InviteStatus @default(PENDING)
  token          String       @unique @default(uuid())
  sentById       String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentBy         User?        @relation("InviteSender", fields: [sentById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ============================================================================
// CRM: Customers, Leads, Deals, Activities
// ============================================================================

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?
  zipCode        String?
  status         CustomerStatus @default(ACTIVE)
  tags           String[]       @default([])
  notes          String?
  avatarUrl      String?
  assignedTo     String?
  totalRevenue   Decimal        @default(0) @db.Decimal(15, 2)
  lastPurchaseAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  invoices       Invoice[]
  orders         Order[]
  activities     Activity[]
  tasks          Task[]
  contacts       Contact[]
  quotations     Quotation[]
  tickets        Ticket[]
  projects       Project[]

  @@index([organizationId])
  @@index([email])
  @@map("customers")
}

model Lead {
  id             String      @id @default(uuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  source         String?
  score          Int         @default(0)
  stage          LeadStage   @default(NEW)
  notes          String?
  tags           String[]    @default([])
  ownerId        String?
  createdById    String?
  convertedToId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  createdBy      User?        @relation("LeadCreator", fields: [createdById], references: [id])
  activities     Activity[]

  @@index([organizationId])
  @@index([ownerId])
  @@map("leads")
}

model Deal {
  id             String      @id @default(uuid())
  organizationId String
  customerId     String?
  title          String
  stage          DealStage   @default(NEW)
  value          Decimal     @default(0) @db.Decimal(15, 2)
  probability    Int         @default(20)
  currency       String      @default("INR")
  expectedCloseDate DateTime?
  closedAt       DateTime?
  ownerId        String?
  createdById    String?
  notes          String?
  tags           String[]    @default([])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  owner          User?        @relation("DealOwner", fields: [ownerId], references: [id])
  createdBy      User?        @relation("DealCreator", fields: [createdById], references: [id])
  activities     Activity[]
  tasks          Task[]

  @@index([organizationId])
  @@index([customerId])
  @@index([ownerId])
  @@map("deals")
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  type           ActivityType
  title          String
  description    String?
  customerId     String?
  leadId         String?
  dealId         String?
  userId         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@map("activities")
}

// ============================================================================
// TASKS & PRODUCTIVITY
// ============================================================================

model Task {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  assigneeId     String?
  createdById    String?
  customerId     String?
  dealId         String?
  workflowId     String?
  executionId    String?
  tags           String[]     @default([])
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy      User?        @relation("CreatedTasks", fields: [createdById], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@index([assigneeId])
  @@index([customerId])
  @@map("tasks")
}

// ============================================================================
// PRODUCTS & INVENTORY
// ============================================================================

model Category {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([organizationId])
  @@map("categories")
}

model Product {
  id             String    @id @default(uuid())
  organizationId String
  categoryId     String?
  sku            String?
  name           String
  description    String?
  price          Decimal   @default(0) @db.Decimal(15, 2)
  cost           Decimal   @default(0) @db.Decimal(15, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  stock          Int       @default(0)
  minStock       Int       @default(0)
  unit           String    @default("pcs")
  imageUrl       String?
  isActive       Boolean   @default(true)
  supplier       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        Category?             @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  invoiceItems    InvoiceItem[]
  inventoryMovements InventoryMovement[]
  quotationItems  QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]
  boms            BillOfMaterials[]
  bomItems        BOMItem[]
  manufacturingOrders ManufacturingOrder[]
  priceRules      PriceRule[]

  @@index([organizationId])
  @@index([sku])
  @@map("products")
}

model InventoryMovement {
  id             String                @id @default(uuid())
  organizationId String
  productId      String
  type           InventoryMovementType
  quantity       Int
  previousStock  Int
  newStock       Int
  referenceId    String?
  referenceType  String?
  notes          String?
  createdById    String?
  createdAt      DateTime              @default(now())

  product        Product               @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@map("inventory_movements")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id             String      @id @default(uuid())
  organizationId String
  customerId     String?
  orderNumber    String
  status         OrderStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(15, 2)
  discount       Decimal     @default(0) @db.Decimal(15, 2)
  total          Decimal     @default(0) @db.Decimal(15, 2)
  currency       String      @default("INR")
  notes          String?
  shippingAddress Json?
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  invoice        Invoice?

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  name        String
  sku         String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
// INVOICES & PAYMENTS
// ============================================================================

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  customerId      String?
  orderId         String?       @unique
  invoiceNumber   String
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  subtotal        Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  discount        Decimal       @default(0) @db.Decimal(15, 2)
  total           Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(15, 2)
  currency        String        @default("INR")
  notes           String?
  termsAndConditions String?
  metadata        Json?
  razorpayOrderId String?
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id])
  order           Order?        @relation(fields: [orderId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String?
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  invoiceId         String?
  amount            Decimal       @db.Decimal(15, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            String?
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}


// ============================================================================
// AUTOMATIONS & WORKFLOWS
// ============================================================================

model Workflow {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         WorkflowStatus @default(ACTIVE)
  triggerType    String
  triggerConfig  Json?
  nodes          Json?
  edges          Json?
  n8nWorkflowId  String?
  lastRunAt      DateTime?
  runCount       Int            @default(0)
  errorCount     Int            @default(0)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions     WorkflowExecution[]

  @@index([organizationId])
  @@map("workflows")
}

model WorkflowExecution {
  id             String          @id @default(uuid())
  organizationId String
  workflowId     String
  status         ExecutionStatus @default(QUEUED)
  triggerData    Json?
  result         Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  n8nExecutionId String?
  createdAt      DateTime        @default(now())

  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@map("workflow_executions")
}

// ============================================================================
// AI ASSISTANT
// ============================================================================

model AIConversation {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  title          String    @default("New Conversation")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  messages       AIMessage[]

  @@index([organizationId])
  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  organizationId String
  role           String   // 'user' | 'assistant' | 'system' | 'tool'
  content        String
  toolCalls      Json?
  toolResults    Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  actionUrl      String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

// ============================================================================
// MARKETING & CAMPAIGNS
// ============================================================================

model Campaign {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         CampaignStatus @default(DRAFT)
  type           String         @default("email")
  targetSegment  Json?
  content        Json?
  scheduledAt    DateTime?
  sentAt         DateTime?
  stats          Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("campaigns")
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model Integration {
  id             String    @id @default(uuid())
  organizationId String
  type           String    // 'razorpay' | 'n8n' | 'gmail' | 'whatsapp' | 'slack' etc
  name           String
  isActive       Boolean   @default(false)
  config         Json?     // encrypted credentials & settings
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("integrations")
}

// ============================================================================
// TEAMS & DEPARTMENTS
// ============================================================================

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams          Team[]

  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String     @id @default(uuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  createdAt      DateTime   @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@map("teams")
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// USAGE & COST LEDGER (P0 API Cost & Usage Protection)
// ============================================================================

model UsageLedger {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  operation      String   // "AI_CHAT", "AI_EMBEDDING", "EMAIL_SEND", "AUTOPILOT_RUN"
  provider       String   // "GEMINI", "OPENAI", "RESEND", "SENDGRID", "SMTP"
  service        String   // "chat", "embedding", "transactional_email", "autopilot"
  requestCount   Int      @default(1)
  tokensUsed     Int?     @default(0)
  estimatedCost  Float?   @default(0.0)
  status         String   // "SUCCESS", "RATE_LIMITED", "QUOTA_EXCEEDED", "FAILED"
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("usage_ledgers")
}

// ============================================================================
// CONTACTS & B2B COMPANIES
// ============================================================================

model Contact {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  jobTitle       String?
  department     String?
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
  @@map("contacts")
}

model Company {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  country        String?  @default("IN")
  size           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("companies")
}

// ============================================================================
// SALES: Quotations & Estimates
// ============================================================================

model Quotation {
  id              String          @id @default(uuid())
  organizationId  String
  customerId      String
  quotationNumber String
  status          QuotationStatus @default(DRAFT)
  issueDate       DateTime        @default(now())
  expiryDate      DateTime?
  subtotal        Decimal         @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(15, 2)
  discount        Decimal         @default(0) @db.Decimal(15, 2)
  total           Decimal         @default(0) @db.Decimal(15, 2)
  notes           String?
  terms           String?
  currency        String          @default("INR")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           QuotationItem[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  productId      String?
  name           String
  description    String?
  quantity       Int       @default(1)
  unitPrice      Decimal   @default(0) @db.Decimal(15, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  discount       Decimal   @default(0) @db.Decimal(15, 2)
  total          Decimal   @default(0) @db.Decimal(15, 2)

  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_items")
}

// ============================================================================
// ACCOUNTING: Chart of Accounts, Journal Entries, Balanced Ledger
// ============================================================================

model Account {
  id             String      @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           AccountType
  balance        Decimal     @default(0) @db.Decimal(15, 2)
  currency       String      @default("INR")
  isSystem       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines   JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("accounts")
}

model JournalEntry {
  id             String        @id @default(uuid())
  organizationId String
  entryNumber    String
  date           DateTime      @default(now())
  reference      String?
  description    String?
  isPosted       Boolean       @default(true)
  totalDebit     Decimal       @default(0) @db.Decimal(15, 2)
  totalCredit    Decimal       @default(0) @db.Decimal(15, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          JournalLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String
  category       String
  amount         Decimal  @default(0) @db.Decimal(15, 2)
  currency       String   @default("INR")
  date           DateTime @default(now())
  payee          String?
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("expenses")
}

// ============================================================================
// PURCHASING: Vendors, Purchase Orders, Vendor Bills
// ============================================================================

model Vendor {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?         @default("IN")
  gstin          String?
  paymentTerms   String?         @default("Net 30")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]

  @@index([organizationId])
  @@map("vendors")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String
  vendorId       String
  poNumber       String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  subtotal       Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal             @default(0) @db.Decimal(15, 2)
  total          Decimal             @default(0) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items          PurchaseOrderItem[]
  bills          VendorBill[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String?
  name            String
  quantity        Int           @default(1)
  unitCost        Decimal       @default(0) @db.Decimal(15, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  total           Decimal       @default(0) @db.Decimal(15, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model VendorBill {
  id              String        @id @default(uuid())
  organizationId  String
  vendorId        String
  purchaseOrderId String?
  billNumber      String
  amount          Decimal       @default(0) @db.Decimal(15, 2)
  dueDate         DateTime?
  status          String        @default("PENDING") // PENDING, PAID, OVERDUE
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vendorId])
  @@map("vendor_bills")
}

// ============================================================================
// MANUFACTURING: BOM, Work Orders, Production
// ============================================================================

model BillOfMaterials {
  id             String               @id @default(uuid())
  organizationId String
  productId      String
  name           String
  version        String               @default("v1.0")
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  items          BOMItem[]
  orders         ManufacturingOrder[]

  @@index([organizationId])
  @@index([productId])
  @@map("bills_of_materials")
}

model BOMItem {
  id        String          @id @default(uuid())
  bomId     String
  productId String
  quantity  Decimal         @default(1) @db.Decimal(10, 4)
  unit      String          @default("pcs")

  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([bomId])
  @@map("bom_items")
}

model ManufacturingOrder {
  id             String              @id @default(uuid())
  organizationId String
  bomId          String
  productId      String
  moNumber       String
  quantity       Int                 @default(1)
  status         ManufacturingStatus @default(PLANNED)
  startDate      DateTime?
  completedDate  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bom            BillOfMaterials     @relation(fields: [bomId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  workOrders     WorkOrder[]

  @@unique([organizationId, moNumber])
  @@index([organizationId])
  @@map("manufacturing_orders")
}

model WorkOrder {
  id                   String             @id @default(uuid())
  manufacturingOrderId String
  operationName        String
  workCenter           String?
  sequence             Int                @default(1)
  status               String             @default("PENDING") // PENDING, IN_PROGRESS, DONE
  durationMinutes      Int                @default(60)

  manufacturingOrder   ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)

  @@index([manufacturingOrderId])
  @@map("work_orders")
}

// ============================================================================
// HELPDESK & SUPPORT TICKETS
// ============================================================================

model Ticket {
  id             String          @id @default(uuid())
  organizationId String
  customerId     String?
  ticketNumber   String
  subject        String
  description    String
  status         TicketStatus    @default(OPEN)
  priority       TicketPriority  @default(MEDIUM)
  assigneeId     String?
  category       String?         @default("General Support")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  comments       TicketComment[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  userId     String?
  authorName String   @default("Support Agent")
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

// ============================================================================
// PRICE LISTS & DYNAMIC PRICING
// ============================================================================

model PriceList {
  id             String      @id @default(uuid())
  organizationId String
  name           String
  currency       String      @default("INR")
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          PriceRule[]

  @@index([organizationId])
  @@map("pricelists")
}

model PriceRule {
  id             String    @id @default(uuid())
  priceListId    String
  productId      String?
  minQuantity    Int       @default(1)
  discountPercent Decimal? @db.Decimal(5, 2)
  fixedPrice     Decimal?  @db.Decimal(15, 2)

  priceList      PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([priceListId])
  @@map("price_rules")
}

// ============================================================================
// PROJECTS & TIMESHEETS
// ============================================================================

model Project {
  id             String        @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  budget         Decimal?      @db.Decimal(15, 2)
  deadline       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tasks          ProjectTask[]
  timeEntries    TimeEntry[]

  @@index([organizationId])
  @@map("projects")
}

model ProjectTask {
  id          String      @id @default(uuid())
  projectId   String
  title       String
  status      String      @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  priority    String      @default("MEDIUM")
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([projectId])
  @@map("project_tasks")
}

model TimeEntry {
  id            String       @id @default(uuid())
  projectId     String
  projectTaskId String?
  userId        String
  hours         Decimal      @db.Decimal(5, 2)
  date          DateTime     @default(now())
  description   String?
  billable      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTask   ProjectTask? @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@map("time_entries")
}

// ============================================================================
// HR: Employees, Leave Management, Attendance
// ============================================================================

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  userId         String?        @unique
  firstName      String
  lastName       String
  email          String
  phone          String?
  department     String?
  jobTitle       String
  hireDate       DateTime       @default(now())
  salary         Decimal?       @db.Decimal(15, 2)
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaves         LeaveRequest[]
  attendance     Attendance[]

  @@index([organizationId])
  @@map("employees")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String
  leaveType   String      // SICK, CASUAL, ANNUAL, UNPAID
  startDate   DateTime
  endDate     DateTime
  daysCount   Int         @default(1)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("leave_requests")
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @default(now())
  status     String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, ON_LEAVE
  checkIn    DateTime?
  checkOut   DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("attendance")
}

// ============================================================================
// DISCUSS & COLLABORATION CHANNELS
// ============================================================================

model Channel {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  description    String?
  type           ChannelType      @default(PUBLIC)
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ChannelMessage[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("channels")
}

model ChannelMessage {
  id         String   @id @default(uuid())
  channelId  String
  userId     String
  userName   String
  content    String
  createdAt  DateTime @default(now())

  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("channel_messages")
}
